{
  "name": "founderflow",
  "version": "1.0.0",
  "description": "FounderFlow — AI Client Acquisition System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.founderflow.engine",
    "productName": "FounderFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "!engine/node_modules",
      "!engine/sessions",
      "!engine/sessions2",
      "!engine/founderflow_sessions",
      "!engine/*.log",
      "!engine/*.txt",
      "!engine/state.json",
      "!engine/fingerprint.json",
      "!engine/comment_scan_state.json",
      "!engine/engine.log"
    ],
    "extraResources": [
      {
        "from": "engine/",
        "to": "engine",
        "filter": [
          "**/*.cjs",
          "**/*.json",
          "!**/node_modules/**",
          "!**/sessions/**",
          "!**/sessions2/**",
          "!**/founderflow_sessions/**"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "zip",
      "icon": "assets/icon.png",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.png"
    }
  },
  "author": "Marvin",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "playwright-core": "^1.61.1"
  }
}
